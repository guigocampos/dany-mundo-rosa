---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  class?: string;
  position?: string;
}
const {
  image,
  alt,
  caption,
  class: extraClass = "",
  position = "center",
} = Astro.props;
const full = await getImage({
  src: image,
  width: Math.min(image.width, 1100),
  format: "webp",
});
---

<figure class:list={["editorial-photo", extraClass]} data-reveal="photo">
  <button
    class="photo-trigger"
    type="button"
    aria-label={`Ampliar imagem: ${caption}`}
    data-lightbox
    data-full={full.src}
  >
    <Image
      src={image}
      alt={alt}
      widths={[400, 700, 1100]}
      sizes="(max-width: 767px) 48vw, 30vw"
      format="webp"
      style={`object-position:${position}`}
      loading="lazy"
    />
  </button>
  <figcaption>{caption}</figcaption>
</figure>
